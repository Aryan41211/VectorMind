# Copy to .env (development) or .env.production (production build).
#
# Base URL the frontend uses to reach the VectorMind API.
#
# Leave EMPTY when the FastAPI backend serves the built frontend from
# frontend/dist/ (the default setup — same origin, so relative paths work),
# or when using the Vite dev server, whose proxy forwards /search and /health
# to localhost:8000.
#
# Set it only when the API lives on a different origin, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
